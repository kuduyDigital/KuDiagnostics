<?xml version="1.0"?>
<ruleset name="KUDUY MCP">
  <file>kuduy-mcp.php</file>
  <file>uninstall.php</file>
  <file>src</file>
  <file>tests</file>

  <arg name="extensions" value="php"/>
  <arg value="sp"/>
  <arg name="colors"/>

  <config name="minimum_wp_version" value="6.9"/>
  <config name="testVersion" value="8.1-"/>

  <rule ref="WordPress">
    <!-- PSR-4 class files (src/Lifecycle/Migrations.php), not class-migrations.php. -->
    <exclude name="WordPress.Files.FileName"/>
  </rule>

  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array" value="kuduy-mcp"/>
    </properties>
  </rule>

  <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
    <properties>
      <property name="prefixes" type="array" value="Kuduy\Mcp,kuduy_mcp"/>
    </properties>
  </rule>

  <!-- Test classes and methods document themselves through their names. -->
  <rule ref="Squiz.Commenting">
    <exclude-pattern>tests/*</exclude-pattern>
  </rule>
  <rule ref="Generic.Commenting.DocComment.MissingShort">
    <exclude-pattern>tests/*</exclude-pattern>
  </rule>
</ruleset>
