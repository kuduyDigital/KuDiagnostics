<?php
/**
 * Minimal stubs of the Elementor 4.3 public API that KUDUY calls (verified in Elementor 4.3.6 source).
 * Elementor is not a dependency of this repo; these only let PHPStan check our side.
 */

namespace Elementor {

	class Plugin {
		/** @var Plugin */
		public static $instance;
		/** @var mixed Core\Documents_Manager */
		public $documents;
		/** @var mixed Widgets_Manager */
		public $widgets_manager;
		/** @var mixed Elements_Manager */
		public $elements_manager;
		/** @var mixed Core\Breakpoints\Manager */
		public $breakpoints;
		/** @var mixed Core\Kits\Manager */
		public $kits_manager;
		/** @var mixed Frontend */
		public $frontend;
		/** @var mixed Core\Modules_Manager */
		public $modules_manager;
		/** @var mixed Core\Files\Manager */
		public $files_manager;
	}
}

namespace Elementor\Core\Base {

	class Document {
		public function get_post(): \WP_Post {}
		public function get_name(): string {}
		/** @return int */
		public function get_id() {}
		/** @return int */
		public function get_main_id() {}
		/**
		 * @param bool $is_built_with_elementor
		 * @return $this
		 */
		public function set_is_built_with_elementor( $is_built_with_elementor ) {}
		public function is_built_with_elementor(): bool {}
		/**
		 * @param string $status
		 * @return array<int, mixed>
		 */
		public function get_elements_data( $status = 'publish' ) {}
		/**
		 * @param array<string, mixed> $data
		 * @return bool
		 */
		public function save( $data ) {}
		/**
		 * @param string|null $setting
		 * @return mixed
		 */
		public function get_settings( $setting = null ) {}
		/** @return string */
		public function get_edit_url() {}
	}
}

namespace ElementorPro\Modules\ThemeBuilder {

	/** Elementor Pro 4.3.2 modules/theme-builder/module.php. */
	class Module {
		/** @return static */
		public static function instance() {}
		/** @return \ElementorPro\Modules\ThemeBuilder\Classes\Conditions_Manager */
		public function get_conditions_manager() {}
		/**
		 * @param int $post_id Post id.
		 * @return \ElementorPro\Modules\ThemeBuilder\Documents\Theme_Document|null
		 */
		public function get_document( $post_id ) {}
	}
}

namespace ElementorPro\Modules\ThemeBuilder\Classes {

	/** Elementor Pro 4.3.2 modules/theme-builder/classes/conditions-manager.php. */
	class Conditions_Manager {
		/** @return array<string, array<string, mixed>> */
		public function get_conditions_config() {}
		/**
		 * @param int    $post_id   Post id.
		 * @param string $condition Condition string.
		 * @return list<array{template_id:int, template_title:string, edit_url:string}>
		 */
		public function get_conditions_conflicts( $post_id, $condition ) {}
		/**
		 * @param int                $post_id    Post id.
		 * @param list<list<string>> $conditions Rows of type, name, sub_name, sub_id.
		 * @return bool
		 */
		public function save_conditions( $post_id, $conditions ) {}
		/**
		 * @param object $document Theme document.
		 * @return list<array{type:string, name:string, sub_name:string, sub_id:string}>
		 */
		public function get_document_conditions( $document ) {}
	}
}

namespace ElementorPro\Modules\ThemeBuilder\Documents {

	/** Elementor Pro 4.3.2 modules/theme-builder/documents/theme-document.php. */
	abstract class Theme_Document extends \Elementor\Core\Base\Document {
		/** @return string */
		public function get_location() {}
	}
}
