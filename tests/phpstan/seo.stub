<?php
/**
 * SEO plugins are not dependencies; this declares only the SEO plugin API KUDUY calls (RESEARCH.md §9),
 * plus the Rank Math per-request caches the integration tests reset (tests/integration/RendersHead.php).
 */

namespace RankMath {
	class Helper {
		public static function is_invalid_registration(): bool {}
		public static function is_module_active( string $id ): bool {}
	}
	class Installer {
		/** @param array<int, string> $modules */
		public static function create_tables( $modules = array() ): void {}
	}
	class Metadata {}
}

namespace RankMath\Paper {
	class Paper {}
}

namespace {
	class WPSEO_Meta {
		/** @var string */
		public static $meta_prefix = '_yoast_wpseo_';
		/** @return mixed */
		public static function get_value( string $key, int $postid = 0 ) {}
		/** @param mixed $meta_value */
		public static function set_value( string $key, $meta_value, int $post_id ): bool {}
		public static function delete( string $key, int $post_id ): bool {}
	}
	class WPSEO_Options {
		/**
		 * @param mixed         $default_value
		 * @param array<string> $option_groups
		 * @return mixed
		 */
		public static function get( string $key, $default_value = null, array $option_groups = array() ) {}
	}
	class WPSEO_Capability_Utils {
		public static function current_user_can( string $capability ): bool {}
	}
	function YoastSEO(): \Yoast\WP\SEO\Main {}
	function aioseo(): \AIOSEO\Plugin\AIOSEO {}
	function seopress_metabox_role_is_blocked( string $type ): bool {}
}

namespace AIOSEO\Plugin {
	class AIOSEO {
		/** @var object{title: \AIOSEO\Plugin\Common\Meta\Title, description: \AIOSEO\Plugin\Common\Meta\Description} */
		public $meta;
		/** @var \AIOSEO\Plugin\Common\Utils\Access */
		public $access;
	}
}

namespace AIOSEO\Plugin\Common\Meta {
	class Title {
		public function getPostTitle( \WP_Post $post, bool $default = false ): string {}
	}
	class Description {
		public function getPostDescription( \WP_Post $post, bool $default = false ): string {}
	}
}

namespace AIOSEO\Plugin\Common\Utils {
	class Access {
