namespace {
	class WPSEO_Meta {
		/** @var string */
		public static $meta_prefix = '_yoast_wpseo_';
		/** @return mixed */
		public static function get_value( string $key, int $postid = 0 ) {}
		/** @param mixed $meta_value */
		public static function set_value( string $key, $meta_value, int $post_id ): bool {}
		public static function delete( string $key, int $post_id ): bool {}
	}
	class WPSEO_Options {
