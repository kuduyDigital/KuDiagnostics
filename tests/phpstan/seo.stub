namespace RankMath\Redirections {
	class DB {
		/**
		 * @param array<string, mixed> $args
		 * @return array{redirections: list<array<string, mixed>>, count: int}
		 */
		public static function get_redirections( $args = array() ) {}
		/** @return array<string, mixed>|false */
		public static function get_redirection_by_id( int $id, string $status = 'all' ) {}
		/** @param array<string, mixed> $args */
		public static function update( $args = array() ): int|false {}
		/** @param int|array<int> $ids */
		public static function change_status( $ids, string $status ): int|false {}
	}
	class Redirection {
		/** @param array<string, mixed> $data */
