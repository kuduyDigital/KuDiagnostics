<?php
/**
 * Corrects a WordPress stub: WP_REST_Request::get_json_params() returns null when the body is not JSON
 * (wp-includes/rest-api/class-wp-rest-request.php: `if ( ! $this->is_json_content_type() ) return null;`).
 */

/**
 * @template T of array
 */
class WP_REST_Request {
	/**
	 * @return array<string, mixed>|null
	 */
	public function get_json_params() {}
}
