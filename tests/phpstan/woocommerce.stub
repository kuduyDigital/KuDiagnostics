<?php
/**
 * WooCommerce is not a dependency; this declares only the WooCommerce API KUDUY and its tests call (RESEARCH.md §10).
 */

namespace Automattic\WooCommerce\Internal\Admin\Schedulers {
	class OrdersScheduler {
		public static function import( int $order_id ): void {}
	}
}

namespace Automattic\WooCommerce\Utilities {
	class OrderUtil {
		public static function custom_orders_table_usage_is_enabled(): bool {}
		public static function custom_orders_table_data_sync_is_enabled(): bool {}
	}
}

namespace {
	define( 'WC_VERSION', '11.2.2' );
	class WC_Data_Exception extends Exception {}
	class WC_DateTime extends DateTime {
		public function date( string $format ): string {}
	}
	class WC_Countries {
		public function get_base_country(): string {}
	}
	class WooCommerce {
		/** @var WC_Countries */
		public $countries;
		public function mailer(): WC_Emails {}
		public function payment_gateways(): WC_Payment_Gateways {}
	}
	function WC(): WooCommerce {}

	abstract class WC_Data {
		public function save(): int {}
		public function get_id(): int {}
		public function delete( bool $force_delete = false ): bool {}
		/**
		 * @param array<string, mixed> $props
		 * @return true|WP_Error
		 */
		public function set_props( array $props, string $context = 'set' ) {}
	}
	class WC_Product_Download {
		public function get_name(): string {}
		public function get_file(): string {}
	}
	class WC_Product_Attribute {
		public function set_id( int $value ): void {}
		public function set_name( string $value ): void {}
		/** @param array<int|string> $value */
		public function set_options( array $value ): void {}
		public function set_position( int $value ): void {}
		public function set_visible( bool $value ): void {}
		public function set_variation( bool $value ): void {}
		public function get_name(): string {}
		/** @return array<int|string> */
		public function get_options(): array {}
		public function get_visible(): bool {}
		public function get_variation(): bool {}
		public function is_taxonomy(): bool {}
	}
	class WC_Product extends WC_Data {
		public function get_type(): string {}
		public function get_name( string $context = 'view' ): string {}
		public function get_status( string $context = 'view' ): string {}
		public function get_sku( string $context = 'view' ): string {}
		public function get_price( string $context = 'view' ): string {}
		public function get_regular_price( string $context = 'view' ): string {}
		public function get_sale_price( string $context = 'view' ): string {}
		public function get_short_description( string $context = 'view' ): string {}
		public function get_stock_status( string $context = 'view' ): string {}
		public function get_manage_stock( string $context = 'view' ): bool {}
		public function get_stock_quantity( string $context = 'view' ): ?int {}
		public function get_parent_id( string $context = 'view' ): int {}
		/** @return array<int> */
		public function get_category_ids( string $context = 'view' ): array {}
		/** @return array<string, mixed> */
		public function get_attributes( string $context = 'view' ): array {}
		/** @return array<string, WC_Product_Download> */
		public function get_downloads( string $context = 'view' ): array {}
		public function get_date_created( string $context = 'view' ): ?WC_DateTime {}
		public function get_date_modified( string $context = 'view' ): ?WC_DateTime {}
		public function get_average_rating( string $context = 'view' ): string {}
		public function get_review_count( string $context = 'view' ): int {}
		public function get_total_sales( string $context = 'view' ): int {}
		/** @return array<int> */
		public function get_children(): array {}
		public function is_on_sale( string $context = 'view' ): bool {}
		public function managing_stock(): bool {}
		public function get_stock_managed_by_id(): int {}
		public function set_name( string $name ): void {}
		public function set_regular_price( string $price ): void {}
		public function set_manage_stock( bool $manage_stock ): void {}
		public function set_stock_quantity( ?int $quantity ): void {}
		public function set_status( string $status ): void {}
		/** @param array<mixed> $raw_attributes */
		public function set_attributes( array $raw_attributes ): void {}
	}
	class WC_Product_Simple extends WC_Product {}
	class WC_Product_Grouped extends WC_Product {}
	class WC_Product_External extends WC_Product {}
	class WC_Product_Variable extends WC_Product {
		/** @param int|WC_Product $product */
		public static function sync( $product, bool $save = true ): WC_Product {}
		public function get_variation_regular_price( string $min_or_max = 'min', bool $for_display = false ): string {}
	}
	class WC_Product_Variation extends WC_Product {
		public function set_parent_id( int $id ): void {}
	}

	class WC_Order_Item {
		public function get_id(): int {}
		public function get_name( string $context = 'view' ): string {}
	}
	class WC_Order_Item_Product extends WC_Order_Item {
		/** @return WC_Product|false|null */
		public function get_product() {}
		public function get_product_id( string $context = 'view' ): int {}
		public function get_variation_id( string $context = 'view' ): int {}
		/** @return int|float */
		public function get_quantity( string $context = 'view' ) {}
		public function get_subtotal( string $context = 'view' ): string {}
		public function get_total( string $context = 'view' ): string {}
		public function get_total_tax( string $context = 'view' ): string {}
	}
	class WC_Order_Item_Shipping extends WC_Order_Item {
		public function get_method_id( string $context = 'view' ): string {}
		public function get_method_title( string $context = 'view' ): string {}
		public function get_total( string $context = 'view' ): string {}
	}
	class WC_Order_Item_Fee extends WC_Order_Item {
		public function get_total( string $context = 'view' ): string {}
	}
	abstract class WC_Abstract_Order extends WC_Data {
		public function get_status( string $context = 'view' ): string {}
		public function get_date_created( string $context = 'view' ): ?WC_DateTime {}
		public function get_currency( string $context = 'view' ): string {}
		public function get_total( string $context = 'view' ): string {}
		public function get_subtotal(): string {}
		public function get_discount_total( string $context = 'view' ): string {}
		public function get_shipping_total( string $context = 'view' ): string {}
		public function get_total_tax( string $context = 'view' ): string {}
		public function get_prices_include_tax( string $context = 'view' ): bool {}
		/** @return array<int, WC_Order_Item> */
		public function get_items( string $types = 'line_item' ): array {}
		/** @return array<int, WC_Order_Item_Shipping> */
		public function get_shipping_methods(): array {}
		/** @return array<int, WC_Order_Item_Fee> */
		public function get_fees(): array {}
		/** @return array<string> */
		public function get_coupon_codes(): array {}
		public function get_item_count( string $item_type = '' ): int {}
		/** @param WC_Product $product */
		public function add_product( $product, int $qty = 1 ): int {}
		public function calculate_totals( bool $and_taxes = true ): string {}
		public function set_status( string $new_status ): void {}
	}
	class WC_Order_Refund extends WC_Abstract_Order {
		public function get_amount( string $context = 'view' ): string {}
		public function get_reason( string $context = 'view' ): string {}
	}
	class WC_Order extends WC_Abstract_Order {
		public function get_order_number(): string {}
		public function get_order_key( string $context = 'view' ): string {}
		public function get_customer_id( string $context = 'view' ): int {}
		public function get_billing_first_name( string $context = 'view' ): string {}
		public function get_billing_last_name( string $context = 'view' ): string {}
		public function get_billing_email( string $context = 'view' ): string {}
		public function get_payment_method( string $context = 'view' ): string {}
		public function get_payment_method_title( string $context = 'view' ): string {}
		public function get_date_paid( string $context = 'view' ): ?WC_DateTime {}
		public function get_date_completed( string $context = 'view' ): ?WC_DateTime {}
		public function get_created_via( string $context = 'view' ): string {}
		public function get_customer_note( string $context = 'view' ): string {}
		public function get_customer_ip_address( string $context = 'view' ): string {}
		public function get_customer_user_agent( string $context = 'view' ): string {}
		public function get_transaction_id( string $context = 'view' ): string {}
		public function get_total_refunded(): string {}
		/** @return array<string, string> */
		public function get_address( string $address_type = 'billing' ): array {}
		/** @return array<WC_Order_Refund> */
		public function get_refunds(): array {}
		public function update_status( string $new_status, string $note = '', bool $manual = false ): bool {}
		public function add_order_note( string $note, int $is_customer_note = 0, bool $added_by_user = false ): int {}
		public function set_billing_first_name( string $value ): void {}
		public function set_billing_last_name( string $value ): void {}
		public function set_billing_email( string $value ): void {}
		public function set_billing_phone( string $value ): void {}
		public function set_billing_address_1( string $value ): void {}
		public function set_billing_city( string $value ): void {}
		public function set_billing_country( string $value ): void {}
		public function set_customer_ip_address( string $value ): void {}
	}
	/**
	 * Coupon getters/setters are called by field name; the ones called directly are declared.
	 */
	class WC_Coupon extends WC_Data {
		/** @param mixed $data Id, code or object. */
		public function __construct( $data = '' ) {}
		public function get_code( string $context = 'view' ): string {}
		public function get_discount_type( string $context = 'view' ): string {}
		/** @return float|string */
		public function get_amount( string $context = 'view' ) {}
		public function get_free_shipping( string $context = 'view' ): bool {}
		public function get_date_expires( string $context = 'view' ): ?WC_DateTime {}
		/** @return float|string */
		public function get_minimum_amount( string $context = 'view' ) {}
		public function get_usage_count( string $context = 'view' ): int {}
		public function get_usage_limit( string $context = 'view' ): int {}
		public function get_description( string $context = 'view' ): string {}
		public function set_status( string $status ): void {}
	}
	class WC_Customer extends WC_Data {
		public function __construct( int $data = 0, bool $is_session = false ) {}
		public function get_email( string $context = 'view' ): string {}
		public function get_first_name( string $context = 'view' ): string {}
		public function get_last_name( string $context = 'view' ): string {}
		public function get_date_created( string $context = 'view' ): ?WC_DateTime {}
		public function get_order_count(): int {}
		/** @return float|string */
		public function get_total_spent() {}
		/** @return WC_Order|false */
		public function get_last_order() {}
		public function get_is_paying_customer( string $context = 'view' ): bool {}
		public function get_billing_country( string $context = 'view' ): string {}
		public function get_billing_city( string $context = 'view' ): string {}
		public function get_billing_address_1( string $context = 'view' ): string {}
		public function get_billing_phone( string $context = 'view' ): string {}
		/** @return array<string, string> */
		public function get_billing( string $context = 'view' ): array {}
		/** @return array<string, string> */
		public function get_shipping( string $context = 'view' ): array {}
		public function set_first_name( string $value ): void {}
		public function set_last_name( string $value ): void {}
		public function set_billing_first_name( string $value ): void {}
		public function set_billing_last_name( string $value ): void {}
		public function set_billing_address_1( string $value ): void {}
		public function set_billing_city( string $value ): void {}
		public function set_billing_country( string $value ): void {}
		public function set_billing_phone( string $value ): void {}
	}
	abstract class WC_Settings_API {
		/** @var string */
		public $id = '';
		/** @var array<string, mixed> */
		public $form_fields = array();
		/** @return array<string, mixed> */
		public function get_form_fields(): array {}
		/** @return mixed */
		public function get_option( string $key, mixed $empty_value = null ) {}
		public function init_settings(): void {}
	}
	abstract class WC_Payment_Gateway extends WC_Settings_API {
		/** @var string */
		public $title = '';
		/** @var string */
		public $enabled = 'yes';
		/** @var string */
		public $method_title = '';
		/** @var array<string> */
		public $supports = array();
		public function get_title(): string {}
		public function get_method_title(): string {}
	}
	class WC_Payment_Gateways {
		/** @return array<string, mixed> */
		public function payment_gateways(): array {}
		public function init(): void {}
	}
	abstract class WC_Shipping_Method extends WC_Settings_API {
		/** @var int */
		public $instance_id = 0;
		/** @var string */
		public $enabled = 'yes';
		public function get_method_title(): string {}
		public function get_title(): string {}
		public function is_enabled(): bool {}
		/** @return array<string, mixed> */
		public function get_instance_form_fields(): array {}
		/** @return mixed */
		public function get_instance_option( string $key, mixed $empty_value = null ) {}
	}
	class WC_Shipping_Zone extends WC_Data {
		public function __construct( int $zone = 0 ) {}
		public function get_zone_name( string $context = 'view' ): string {}
		public function get_zone_order( string $context = 'view' ): int {}
		/** @return array<object{code: string, type: string}> */
		public function get_zone_locations( string $context = 'view' ): array {}
		/** @return array<int, WC_Shipping_Method> */
		public function get_shipping_methods( bool $enabled_only = false, string $context = 'admin' ): array {}
		public function set_zone_name( string $name ): void {}
		public function add_location( string $code, string $type ): void {}
		public function add_shipping_method( string $type ): int {}
	}
	class WC_Shipping_Zones {
		/** @return array<int|string, array<string, mixed>> */
		public static function get_zones( string $context = 'admin' ): array {}
		public static function get_zone( int $zone_id ): WC_Shipping_Zone {}
	}
