namespace FluentForm\App\Models {
	/** Query builder of Fluent Forms' ORM (only the calls KUDUY makes). */
	class Builder {
		/** @param mixed $operator */
		public function where( string $column, $operator = null, $value = null ): Builder {}
		/** @param array<int, mixed> $values */
		public function whereNotIn( string $column, array $values ): Builder {}
		public function orderBy( string $column, string $direction = 'asc' ): Builder {}
		public function offset( int $offset ): Builder {}
		public function limit( int $limit ): Builder {}
		/** @return list<object> */
		public function get(): array {}
		public function first(): ?object {}
		public function count(): int {}
		public function delete(): int {}
	}
	class Form {
		/** @param mixed $operator */
		public static function where( string $column, $operator = null, $value = null ): Builder {}
		public static function orderBy( string $column, string $direction = 'asc' ): Builder {}
	}
	class Submission {
		/** @param mixed $operator */
		public static function where( string $column, $operator = null, $value = null ): Builder {}
	}
	class SubmissionMeta {
		/** @param mixed $operator */
		public static function where( string $column, $operator = null, $value = null ): Builder {}
	}
}

