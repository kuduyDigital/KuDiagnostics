	class Flamingo_Inbound_Message {
		const post_type        = 'flamingo_inbound';
		const spam_status      = 'flamingo-spam';
		const channel_taxonomy = 'flamingo_inbound_channel';
		/** @var string */
		public $channel;
		/** @var string */
		public $subject;
		/** @var string */
		public $from;
		/** @var string */
		public $from_name;
		/** @var string */
		public $from_email;
		/** @var array<string, mixed> */
		public $fields;
		/** @var array<string, mixed> */
		public $meta;
		/** @var array<string, mixed> */
		public $akismet;
		/** @var bool */
		public $spam;
		/** @var array<int, mixed> */
		public $spam_log;
		/** @param int|WP_Post|null $post */
		public function __construct( $post = null ) {}
		/**
		 * @param array<string, mixed>|string $args
		 * @return list<Flamingo_Inbound_Message>
		 */
		public static function find( $args = '' ): array {}
		/** @param array<string, mixed>|string $args */
		public static function count( $args = '' ): int {}
		/** @param array<string, mixed>|string $args */
		public static function add( $args = '' ): Flamingo_Inbound_Message {}
		/** @return int */
		public function id() {}
		/** @return bool|null */
		public function trash() {}
		/** @return bool|null */
		public function untrash() {}
		/** @return int|null */
		public function spam() {}
		/** @return int|null */
		public function unspam() {}
	}

	function flamingo_akismet_is_active(): bool {}

