namespace {
	define( 'WPCF7_VERSION', '6.2.4.1' );
	define( 'FLAMINGO_VERSION', '2.6.4' );
	define( 'FLUENTFORM_VERSION', '6.2.17' );
	define( 'WPFORMS_VERSION', '2.0.4' );

	class WPCF7_FormTag {
		/** @var string */
		public $type;
		/** @var string */
		public $basetype;
		/** @var string */
		public $name;
		/** @var array<int, string> */
		public $values;
		/** @var array<int, string> */
		public $labels;
		public function is_required(): bool {}
	}

	class WPCF7_ContactForm {
		const post_type = 'wpcf7_contact_form';
		/**
		 * @param array<string, mixed>|string $args
		 * @return list<WPCF7_ContactForm>
		 */
		public static function find( $args = '' ): array {}
		/** @return int */
		public function id() {}
		/** @return string */
		public function name() {}
		/** @return string */
		public function title() {}
		/** @param string $title */
		public function set_title( $title ): void {}
		/** @return string */
		public function locale() {}
		/** @return mixed */
		public function prop( string $name ) {}
		/** @return array<string, mixed> */
		public function get_properties(): array {}
		/** @param array<string, mixed> $properties */
		public function set_properties( array $properties ): void {}
		/** @return int */
		public function save() {}
		/** @return list<WPCF7_FormTag> */
		public function scan_form_tags( $cond = null ): array {}
		/** @param array<string, mixed>|string $options */
		public function shortcode( $options = '' ): string {}
	}

