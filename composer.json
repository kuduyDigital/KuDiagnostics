{
  "name": "kuduy/kuduy-mcp",
  "description": "MCP server for WordPress: lets Claude manage a site under the consenting user's permissions.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "autoload": {
    "psr-4": {
      "Kuduy\\Mcp\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kuduy\\Mcp\\Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "8.1.0"
    },
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "lint": "phpcs",
    "analyse": "phpstan analyse --memory-limit=1G",
    "test:static": ["@lint", "@analyse"]
  },
  "require-dev": {
    "phpstan/phpstan": "^2",
    "phpunit/phpunit": "^10.5",
    "szepeviktor/phpstan-wordpress": "^2",
    "wp-coding-standards/wpcs": "^3"
  }
}
