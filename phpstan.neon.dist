includes:
  - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
  level: 6
  stubFiles:
    - tests/phpstan/wp-rest-request.stub
  # Elementor is not a dependency; this declares only the Elementor API KUDUY calls.
  scanFiles:
    - tests/phpstan/elementor.stub
    - tests/phpstan/seo.stub
    - tests/phpstan/woocommerce.stub
    - tests/phpstan/acf.stub
  paths:
    - kuduy-mcp.php
    - uninstall.php
    - src
    - tests
