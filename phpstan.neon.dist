includes:
  - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
  level: 6
  stubFiles:
    - tests/phpstan/wp-rest-request.stub
  # Elementor is not a dependency; this declares only the Elementor API KUDUY calls.
  scanFiles:
    - tests/phpstan/elementor.stub
    - tests/phpstan/seo.stub
    - tests/phpstan/woocommerce.stub
    - tests/phpstan/acf.stub
    - tests/phpstan/forms.stub
    - tests/phpstan/beaver.stub
    # Stand-ins for paid plugins (WPBakery): their names, not ours, so they are scanned but not analysed.
    - tests/integration/fakes/wpbakery.php
  paths:
    - kuduy-mcp.php
    - uninstall.php
    - src
    - tests
  excludePaths:
    analyse:
      - tests/integration/fakes
